generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  BATCH_REP
}

enum TshirtSize {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum AttendeeType {
  ADULT
  CHILD
  INFANT
}

model Batch {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. "2014", "14", "CSE-2014"
  name      String? // optional human label
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reps         User[]        @relation("BatchReps")
  participants Participant[]
  /// Cash handed to super admin against ticket sales for this batch (BDT, same unit as Ticket.price).
  cashSettlements BatchCashSettlement[]
  sportRosterEntries SportRosterEntry[]
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  role         Role     @default(BATCH_REP)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  batchId String?
  batch   Batch?  @relation("BatchReps", fields: [batchId], references: [id], onDelete: SetNull)

  createdParticipants Participant[] @relation("CreatedBy")
  cashSettlementsRecorded BatchCashSettlement[] @relation("CashSettlementsRecorded")
  sportRosterEntriesCreated SportRosterEntry[] @relation("SportRosterCreatedBy")
  attendeesCheckedIn Attendee[] @relation("AttendeeCheckIn")

  @@index([role])
  @@index([batchId])
}

/// Super admin records cash received from a batch (ticket sales remittance).
model BatchCashSettlement {
  id           String   @id @default(cuid())
  batchId      String
  batch        Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  amountBdt    Int
  note         String?
  recordedById String
  recordedBy   User     @relation("CashSettlementsRecorded", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())

  @@index([batchId])
  @@index([recordedById])
  @@index([createdAt])
}

model Ticket {
  id           String       @id @default(cuid())
  code         String       @unique // e.g. "ADULT", "CHILD", "INFANT"
  name         String
  price        Int // store in smallest currency unit (e.g. BDT * 100) OR plain BDT; choose one consistently
  attendeeType AttendeeType
  hasTshirt    Boolean      @default(true)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  participants Participant[]
  attendees    Attendee[]

  @@index([attendeeType])
}

model Participant {
  id String @id @default(cuid())

  adultCount  Int @default(0)
  childCount  Int @default(0)
  infantCount Int @default(0)

  totalChildrenAttending Int     @default(0)
  notes                  String?

  paymentScreenshotUrl String?

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  attendees Attendee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ticket    Ticket?  @relation(fields: [ticketId], references: [id])
  ticketId  String?

  @@index([batchId])
  @@index([createdById])
}

model Attendee {
  id String @id @default(cuid())

  type     AttendeeType
  fullName String?
  phone    String?
  tshirt   TshirtSize?

  /// Short code for QR / manual lookup at gate.
  checkInCode String? @unique
  checkedInAt DateTime?
  checkedInById String?
  checkedInBy   User?   @relation("AttendeeCheckIn", fields: [checkedInById], references: [id], onDelete: SetNull)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId])
  @@index([type])
  @@index([tshirt])
  @@index([ticketId])
  @@index([phone])
  @@index([checkedInAt])
}

model SystemSetting {
  /// Singleton row (use id="singleton")
  id               String   @id
  registrationOpen Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

/// Configurable game/sport for per-batch roster (separate from ticket `Participant`).
model Sport {
  id                   String   @id @default(cuid())
  name                 String
  code                 String   @unique
  maxPlayersPerBatch   Int
  dataEntryOpen        Boolean  @default(true)
  sortOrder            Int      @default(0)
  /// Guidance for batch reps (e.g. age bands, school labels); multiline ok.
  note                 String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  rosterEntries SportRosterEntry[]

  @@index([sortOrder])
}

/// One roster row = one player for a sport within a batch.
model SportRosterEntry {
  id          String   @id @default(cuid())
  sportId     String
  sport       Sport    @relation(fields: [sportId], references: [id], onDelete: Cascade)
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User     @relation("SportRosterCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  fullName String
  phone    String?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sportId, batchId])
  @@index([batchId])
  @@index([createdById])
}
